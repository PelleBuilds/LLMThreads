@using ThreadMapLLM.Models
@* @using ThreadMapLLM.Models
@{
    ViewData["Title"] = "Home Page";
}
 *@
<header>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplication2</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
   
</header>
@model ChatViewModel
<body class="bg-dark text-white vh-100 overflow-hidden">

    <div class="row g-0 h-100">

        <!-- Left Sidebar -->
        <div class="col-2 bg-dark  d-flex flex-column" id="sidebar-left">

            <div class="text-center fw-bold py-3 border-bottom fs-5">
                Chats
            </div>

            <div class="flex-grow-1 overflow-auto">

                @foreach (Chat chat in Model.Chats)
                {
                    <button class="btn btn-dark text-start rounded-0 border-0 border-bottom w-100 py-3">
                        @chat.ConversationId
                    </button>
                }

            </div>

        </div>

        <!-- Chat -->
        <div class="col-8 d-flex justify-content-center align-items-center">

            <div class="bg-secondary bg-opacity-10 rounded-start-4 shadow-lg p-4 w-100 h-100">

                <h1 id="welcome-text" class="text-center mb-4 fw-light">
                    How can I help?
                </h1>

                <div id="chat-window"
                     class="overflow-y-scroll h-75 pe-2 no-scrollbar">
                </div>

            </div>

        </div>

        <!-- Right Sidebar -->
        <div class="col-2 bg-black shadow-lg">

            <div id="sandpack-widget-root"
                 data-initial-code="export default function App() { return <h1>Hej!</h1> }"
                 class="h-100 bg-dark w-100">
            </div>

        </div>

    </div>

    <div class="position-fixed bottom-0 start-50 translate-middle-x mb-4 w-50" id="userinputgroup">

        <div class="input-group shadow-lg">

            <input id="userInputField"
                   class="form-control bg-dark text-white "
                   placeholder="Type your query..." />

            <button onclick="sendMessage()" class="btn btn-dark btn-outline-light ">
                Send
            </button>

            <button onclick="generateCode()" class="btn btn-dark btn-outline-light">
                Code
            </button>

        </div>

    </div>

    <script type="module" src="~/js/react-widget/sandpack-widget.js"></script>

    @section Scripts {
        <script src="~/js/site.js"></script>
    }

</body>

